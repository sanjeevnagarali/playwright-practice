{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@pages/*": ["src/pages/*"],
      "@components/*": ["src/components/*"],
      "@api/*": ["src/api/*"],
      "@data/*": ["src/data/*"],
      "@utils/*": ["src/utils/*"],
      "@integrations/*": ["src/integrations/*"],
      "@fixtures": ["src/fixtures/index.ts"],
      "@config/*": ["config/*"]
    }
  },
  "include": ["src", "tests", "config", "playwright.config.ts"]
}
